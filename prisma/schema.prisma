generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id              String           @id @default(cuid())
  name            String?
  email           String?          @unique
  emailVerified   DateTime?
  image           String?
  role            Role             @default(USER)
  accounts        Account[]
  sessions        Session[]
  watchlist       Watchlist[]
  artistRequests  ArtistRequest[]
  linkSuggestions LinkSuggestion[]
  modInvites      ModInvite[]
  modRequests     ModRequest[]
  samplePacks     SamplePack[]
  packClicks      PackClick[]
  packWatchlists  PackWatchlist[]
  subscription    UserSubscription?
  featureUsage    FeatureUsage[]
  entitlementOverrides UserEntitlementOverride[]
  personas        UserPersona[]
  labelProfile    LabelProfile?    @relation("LabelOwner")
  labelsAdded     LabelProfile[]   @relation("LabelAddedBy")
  coverArtGigs    CoverArtGig[]    @relation("CoverArtSeller")
  ordersPurchased CoverArtOrder[]  @relation("CoverArtBuyer")
  ordersSold      CoverArtOrder[]  @relation("CoverArtSeller")
  orderMessages   OrderMessage[]
  reviewsGiven    MarketplaceReview[] @relation("ReviewsGiven")
  reviewsReceived MarketplaceReview[] @relation("ReviewsReceived")
  onboardingCompletedAt DateTime?
  createdAt       DateTime         @default(now())
}

enum PersonaType {
  ARTIST
  LABEL
  COVER_ARTIST
  CONSUMER
}

model UserPersona {
  id          String       @id @default(cuid())
  userId      String
  type        PersonaType
  slug        String       @unique
  displayName String
  bio         String?      @db.Text
  avatarUrl   String?
  bannerUrl   String?
  genres      String[]     @default([])
  links       Json?
  verified    Boolean      @default(false)
  artistId    String?
  artist      Artist?      @relation(fields: [artistId], references: [id], onDelete: SetNull)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([userId, type])
  @@index([type, verified])
  @@index([displayName])
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum FeatureValueType {
  BOOLEAN
  NUMBER
  STRING
  JSON
}

model Plan {
  id              String             @id @default(cuid())
  slug            String             @unique
  name            String
  description     String?            @db.Text
  rank            Int                @default(0)
  active          Boolean            @default(true)
  public          Boolean            @default(true)
  paddleProductId String?
  paddlePriceId   String?
  features        PlanFeature[]
  subscriptions   UserSubscription[]
  overrides       UserEntitlementOverride[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([active, public, rank])
}

model Feature {
  id           String           @id @default(cuid())
  key          String           @unique
  name         String
  description  String?          @db.Text
  category     String           @default("General")
  valueType    FeatureValueType @default(BOOLEAN)
  unit         String?
  defaultValue Json?
  active       Boolean          @default(true)
  sortOrder    Int              @default(0)
  planFeatures PlanFeature[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([active, category, sortOrder])
}

model PlanFeature {
  id        String   @id @default(cuid())
  planId    String
  featureId String
  value     Json
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature   Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, featureId])
  @@index([featureId])
}

model UserSubscription {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  planId                 String?
  provider               String   @default("PADDLE")
  providerCustomerId     String?  @unique
  providerSubscriptionId String?  @unique
  status                 String   @default("free")
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean  @default(false)
  trialEndsAt            DateTime?
  graceEndsAt            DateTime?
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                   Plan?    @relation(fields: [planId], references: [id], onDelete: SetNull)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([provider, status])
  @@index([planId])
}

model FeatureUsage {
  id          String   @id @default(cuid())
  userId      String
  featureKey  String
  periodStart DateTime
  periodEnd   DateTime
  used        Int      @default(0)
  resetAt     DateTime
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, featureKey, periodStart])
  @@index([featureKey, periodStart])
  @@index([resetAt])
}

model UserEntitlementOverride {
  id          String   @id @default(cuid())
  userId      String
  planId      String?
  featureKey  String?
  value       Json?
  active      Boolean  @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  note        String?  @db.Text
  createdById String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        Plan?    @relation(fields: [planId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, active])
  @@index([featureKey])
}

model BillingWebhookEvent {
  id          String    @id @default(cuid())
  provider    String    @default("PADDLE")
  eventId     String
  eventType   String
  status      String    @default("PENDING")
  payload     Json?
  error       String?   @db.Text
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([provider, eventId])
  @@index([provider, eventType])
  @@index([status, createdAt])
}

enum Platform {
  YOUTUBE
  SPOTIFY
  TIKTOK
  INSTAGRAM
}

model Artist {
  id             String           @id @default(cuid())
  spotifyId      String?          @unique
  deezerId       Int?             @unique
  name           String
  imageUrl       String?
  bannerUrl      String?
  bio            String?
  genres         String[]         @default([])
  spotifyPopularity Int           @default(0)
  watchlistCount Int              @default(0)
  addedById      String
  links          ArtistLink[]
  watchlistedBy  Watchlist[]
  suggestions    LinkSuggestion[]
  requests       ArtistRequest[]
  snapshots      ArtistSnapshot[]
  rankSnapshots  RankSnapshot[]
  tracks         Track[]
  personaLinks   UserPersona[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model ArtistLink {
  id               String   @id @default(cuid())
  artistId         String
  platform         Platform
  url              String
  handle           String?
  followerCount    Int      @default(0)
  monthlyListeners Int      @default(0)
  platformId       String?
  artist           Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([artistId, platform])
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  artistId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, artistId])
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model ArtistRequest {
  id         String        @id @default(cuid())
  type       String        @default("ADD") // ADD or REMOVAL
  name       String
  links      String        @default("")
  artistId   String?
  reason     String?
  status     RequestStatus @default(PENDING)
  reviewedBy String?
  reviewNote String?
  userId     String
  artist     Artist?       @relation(fields: [artistId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model LinkSuggestion {
  id         String        @id @default(cuid())
  artistId   String
  platform   Platform
  url        String
  note       String?
  status     RequestStatus @default(PENDING)
  reviewedBy String?
  userId     String
  artist     Artist        @relation(fields: [artistId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model ModInvite {
  id          String       @id @default(cuid())
  code        String       @unique
  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id], onDelete: Cascade)
  maxUses     Int          @default(1)
  usedCount   Int          @default(0)
  expiresAt   DateTime?
  active      Boolean      @default(true)
  requests    ModRequest[]
  createdAt   DateTime     @default(now())
}

model ModRequest {
  id         String        @id @default(cuid())
  userId     String
  inviteId   String
  status     RequestStatus @default(PENDING)
  reviewedBy String?
  reviewNote String?
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  invite     ModInvite     @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([userId, inviteId])
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model ArtistSnapshot {
  id                   String   @id @default(cuid())
  artistId             String
  monthlyListeners     Int      @default(0)
  followerCount        Int      @default(0)
  youtubeSubscribers   Int      @default(0)
  tiktokFollowers      Int      @default(0)
  instagramFollowers   Int      @default(0)
  artist               Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  createdAt            DateTime @default(now())

  @@index([artistId, createdAt])
}

model RankSnapshot {
  id        String   @id @default(cuid())
  artistId  String
  rank      Int
  date      String
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([artistId, date])
  @@index([date])
}

model Track {
  id              String   @id @default(cuid())
  spotifyId       String?  @unique
  deezerId        String?  @unique
  artistId        String
  name            String
  albumName       String?
  albumImageUrl   String?
  previewUrl      String?
  durationMs      Int      @default(0)
  popularity         Int      @default(0)
  spotifyPopularity  Int      @default(0)
  youtubeVideoId     String?
  youtubeViews       Int      @default(0)
  trackNumber        Int      @default(0)
  discNumber      Int      @default(0)
  explicit        Boolean  @default(false)
  releaseDate     String?
  spotifyUrl      String?
  deezerUrl       String?
  bpm             Float?
  gain            Float?
  featuredArtists String[] @default([])
  contributorIds  String[] @default([])
  artist          Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  snapshots       TrackSnapshot[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([popularity(sort: Desc)])
  @@index([artistId, popularity(sort: Desc)])
}

model TrackSnapshot {
  id                String   @id @default(cuid())
  trackId           String
  popularity        Int      @default(0)
  spotifyPopularity Int      @default(0)
  youtubeViews      Int      @default(0)
  track             Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  @@index([trackId, createdAt])
}

model UpdateLog {
  id             String   @id @default(cuid())
  trigger        String   @default("manual") // manual | cron
  updateType     String   @default("stats") // stats | songs
  status         String   @default("running") // running | completed | failed
  totalArtists   Int      @default(0)
  updatedCount   Int      @default(0)
  failedCount    Int      @default(0)
  durationMs     Int      @default(0)
  details        String?  @db.Text // JSON array of per-artist results
  error          String?
  createdAt      DateTime @default(now())
  completedAt    DateTime?
}

model SamplePack {
  id            String        @id @default(cuid())
  name          String
  description   String?       @db.Text
  imageUrl      String?
  seller        String?
  payhipUrl     String?
  gumroadUrl    String?
  priceCents    Int           @default(0)
  currency      String        @default("USD")
  ratingAverage Float?
  ratingCount   Int           @default(0)
  salesCount    Int?
  tags          String[]      @default([])
  published     Boolean       @default(true)
  clickCount    Int           @default(0)
  watchlistCount Int          @default(0)
  addedById     String
  addedBy       User          @relation(fields: [addedById], references: [id])
  versions      PackVersion[]
  clicks        PackClick[]
  watchlistedBy PackWatchlist[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model PackVersion {
  id          String     @id @default(cuid())
  packId      String
  name        String
  priceCents  Int        @default(0)
  currency    String     @default("USD")
  description String?    @db.Text
  sortOrder   Int        @default(0)
  pack        SamplePack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@index([packId, sortOrder])
}

model PackClick {
  id        String     @id @default(cuid())
  packId    String
  platform  String     // "payhip" or "gumroad"
  userId    String?
  ipHash    String?
  pack      SamplePack @relation(fields: [packId], references: [id], onDelete: Cascade)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())

  @@unique([packId, userId])
  @@unique([packId, ipHash])
  @@index([packId])
}

model PackWatchlist {
  id        String     @id @default(cuid())
  packId    String
  userId    String?
  ipHash    String?
  pack      SamplePack @relation(fields: [packId], references: [id], onDelete: Cascade)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())

  @@unique([packId, userId])
  @@unique([packId, ipHash])
  @@index([packId])
}

model LabelProfile {
  id                  String   @id @default(cuid())
  slug                String   @unique @default(cuid())
  name                String
  email               String
  iconUrl             String?
  color               String   @default("#c026d3")
  active              Boolean  @default(true)
  verified            Boolean  @default(false)
  guidelines          String?  @db.Text
  discordWebhookUrl   String?
  userId              String?  @unique
  user                User?    @relation("LabelOwner", fields: [userId], references: [id], onDelete: SetNull)
  addedById           String
  addedBy             User     @relation("LabelAddedBy", fields: [addedById], references: [id])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("SubmitLabel")
}

enum CoverArtOrderStatus {
  PENDING_PAYMENT
  PAID
  IN_PROGRESS
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
}

model CoverArtGig {
  id            String            @id @default(cuid())
  sellerId      String
  seller        User              @relation("CoverArtSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  title         String
  description   String            @db.Text
  tags          String[]          @default([])
  imageUrls     String[]          @default([])
  deliveryDays  Int               @default(3)
  revisions     Int               @default(2)
  published     Boolean           @default(true)
  ratingAverage Float?
  ratingCount   Int               @default(0)
  orderCount    Int               @default(0)
  tiers         CoverArtGigTier[]
  orders        CoverArtOrder[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([published, createdAt])
  @@index([sellerId])
}

model CoverArtGigTier {
  id            String          @id @default(cuid())
  gigId         String
  name          String
  description   String?         @db.Text
  priceCents    Int
  currency      String          @default("USD")
  deliveryDays  Int?
  revisions     Int?
  sortOrder     Int             @default(0)
  paddlePriceId String?
  gig           CoverArtGig     @relation(fields: [gigId], references: [id], onDelete: Cascade)
  orders        CoverArtOrder[]

  @@index([gigId, sortOrder])
}

model CoverArtOrder {
  id                  String              @id @default(cuid())
  gigId               String
  tierId              String
  buyerId             String
  sellerId            String
  status              CoverArtOrderStatus @default(PENDING_PAYMENT)
  brief               String              @db.Text
  priceCents          Int
  currency            String              @default("USD")
  paddleTransactionId String?             @unique
  deliveryUrls        String[]            @default([])
  deliveryNote        String?             @db.Text
  paidAt              DateTime?
  deliveredAt         DateTime?
  completedAt         DateTime?
  gig                 CoverArtGig         @relation(fields: [gigId], references: [id], onDelete: Cascade)
  tier                CoverArtGigTier     @relation(fields: [tierId], references: [id], onDelete: Restrict)
  buyer               User                @relation("CoverArtBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller              User                @relation("CoverArtSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  messages            OrderMessage[]
  review              MarketplaceReview?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([gigId])
}

model OrderMessage {
  id        String        @id @default(cuid())
  orderId   String
  senderId  String
  body      String        @db.Text
  order     CoverArtOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sender    User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@index([orderId, createdAt])
}

model MarketplaceReview {
  id         String        @id @default(cuid())
  orderId    String        @unique
  reviewerId String
  revieweeId String
  rating     Int
  comment    String?       @db.Text
  order      CoverArtOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reviewer   User          @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee   User          @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())

  @@index([revieweeId, createdAt])
}